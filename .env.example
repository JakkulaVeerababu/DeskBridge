# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Your Freshdesk subdomain, e.g. if your URL is https://acme.freshdesk.com use: acme
FRESHDESK_DOMAIN=yourcompany

# Your Freshdesk API key (Profile Settings -> View API Key)
FRESHDESK_API_KEY=your_api_key_here

# Set to false to see raw PII in outputs (useful for debugging, not for production)
DESKBRIDGE_MASK_PII=true

# Maximum tickets per page returned by list_tickets (Freshdesk hard cap is 100)
DESKBRIDGE_MAX_PAGE_SIZE=30
